  "log": {
    "type": "function",
    "function": {
      "name": "record_log",
      "description": "Record your own declared observations; no peer message.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "carryover_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^[\\x20-\\x7E\\t\\r\\n]+$"
          },
          "image_reflection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800,
            "pattern": "^[\\x20-\\x7E\\t\\r\\n]+$"
          }
        },
        "required": [
          "carryover_note",
          "image_reflection"
        ]
      }
    }
  },
  "first_visual_action": [
    {
      "type": "function",
      "function": {
        "name": "create_visual",
        "description": "Commit your private declared communication plan, then create a genuine image. Plans are not sent to the renderer or peers.",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2905
            },
            "message_intent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 280,
              "pattern": "^[\\x20-\\x7E\\t\\r\\n]+$"
            },
            "recipient_hypothesis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 320,
              "pattern": "^[\\x20-\\x7E\\t\\r\\n]+$"
            },
            "success_check": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[\\x20-\\x7E\\t\\r\\n]+$"
            }
          },
          "required": [
            "prompt",
            "message_intent",
            "recipient_hypothesis",
            "success_check"
          ]
        }
      }
    }
  ],
