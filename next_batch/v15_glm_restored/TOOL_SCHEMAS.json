        "name": "record_vote",
        "description": "Record a real choice and a separate fallible private interpretation.",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decision": {
              "type": "string",
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4",
                "reject_all"
              ]
            }
          },
          "required": [
            "decision"
          ]
        }
      }
    },
